# Experiment identity
EXP_NAME="gpt175b_1024npus_energy_and_time"
JOB_NAME="gpt175b_1024npus_energy_and_time"

# Model/objective settings
MODEL_NAME="GPT_175B"
MODEL_NUM=10
NUM_NPUS=1024
OBJECTIVE_KEY="energy_and_time"

# Optimization settings
BUDGET=1000
INIT_SAMPLES=100
N_WORKERS=8
TOP_K=10
CLEANUP_BATCH_SIZE=20
SIM_TYPE="g2"
TOPOLOGY="FoldedClos"
ROUTING_MODE="foldedclos_uniform"

# Resource policy (used by launch_all.sh)
CORES_PERCENT=32
MEM_PER_CPU_GB_OVERRIDE=10
# Optional hard overrides:
# CPUS_PER_TASK_OVERRIDE=
# MEM_PER_CPU_GB_OVERRIDE=
# PARTITION_OVERRIDE=

# Paths
SWEEP_SCRIPT="../../../Optimization/examples/example_deephyper_opt_sweep.py"
START_ENV_SCRIPT="../../../../../start_py_311.sh"
SEARCH_SPACE_PATH="inputs/search_space.json"
RESULT_FOLDER_PREFIX="outputs"
